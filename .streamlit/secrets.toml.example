# Copia este archivo a `.streamlit/secrets.toml` (está en .gitignore).
# En Streamlit Cloud: Manage app → Settings → Secrets.
# El tablero no tiene formulario de login: solo lee esta tabla.

[odoo]
url = "https://firefly-e.odoo.com"
db = "nombre-de-la-base"
username = "usuario@firefly-e.com"
# Ajustes del usuario → Seguridad de la cuenta → Nueva clave API
api_key = "tu-api-key"

# Idioma de los nombres traducidos (el SQL usaba es_CO, luego es_419, luego en_US).
lang = "es_CO"

# %(company_id)s de las consultas. Si lo omites, se usa la compañía del usuario.
company_id = 1

# project.project.service_line de Transformación Digital.
service_line = "digital_transformation"

# Horas registradas: GS Gestión Soporte se reporta en el tablero de soporte.
exclude_project_ids = [567]
# Customer Care entra en horas registradas aunque no tenga service_line.
include_project_ids = [119]

# Las horas que se debían entregar en el mes usan el horario laboral, los festivos
# y las ausencias, multiplicados por este factor. 0.8 y 80 significan lo mismo.
factor_entrega = 1.0
